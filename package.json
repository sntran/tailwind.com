{
  "name": "tailwind.com",
  "version": "0.6.0",
  "description": "Tailwind CSS in one executable file, with no Node.js at run time: npx tailwind.com, and the same compiler as WebAssembly, also in the browser",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sntran/tailwind.com.git"
  },
  "homepage": "https://github.com/sntran/tailwind.com#readme",
  "keywords": ["tailwindcss", "css", "cli", "wasm", "wasi", "cosmopolitan"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tailwind.com": "js/tailwind.com.mjs"
  },
  "jsdelivr": "./js/page.js",
  "unpkg": "./js/page.js",
  "exports": {
    ".": {
      "browser": "./js/browser.mjs",
      "default": "./js/node.mjs"
    },
    "./tailwind.wasm": {
      "browser": "./runtime/tailwind-browser.wasm",
      "default": "./runtime/tailwind.wasm"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "js/",
    "runtime/",
    "LICENSE",
    "NOTICE",
    "licenses/"
  ]
}
